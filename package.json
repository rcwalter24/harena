{
  "name": "harena",
  "version": "0.1.0",
  "private": true,
  "description": "A top-down 2D arena where AI-written bots fight each other.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.engine.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "review": "node scripts/review.ts",
    "docs": "node scripts/gen-bot-api.ts",
    "docs:check": "node scripts/gen-bot-api.ts --check",
    "batch": "node cli/batch.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@typesafe-ai/sdk": "^0.6.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "mediabunny": "^1.60.0"
  }
}
